{
  "allowed_modify_patterns": [
    "^(\\.github/workflows/.*\\.ya?ml|README\\.md|docs/.*|policies/.*|profiles/.*|provenance/release-manifest-v0\\.1\\.json|pyproject\\.toml|schemas/.*|scripts/.*|src/.*|tests/.*)$"
  ],
  "allowed_paths": [
    ".github/workflows/*.yml",
    ".github/workflows/*.yaml",
    "README.md",
    "docs/**",
    "policies/**",
    "profiles/**",
    "provenance/release-manifest-v0.1.json",
    "pyproject.toml",
    "schemas/**",
    "scripts/**",
    "src/**",
    "tests/**"
  ],
  "baseline_forbidden_modify_patterns": [
    "^\\.git/",
    "^\\.ssh/",
    "(^|/)id_rsa",
    "\\.(pem|key)$"
  ],
  "candidate_release_manifest": "provenance/release-manifest-v0.1.json",
  "forbidden_modify_patterns": [
    "(^|/)(credential|credentials|secret|secrets)(/|$)",
    "\\.(pem|key)$",
    "^bootstrap/",
    "^AGENTS\\.md$",
    "^\\.gitmodules$"
  ],
  "forbidden_paths": [
    "AGENTS.md",
    "bootstrap/**",
    ".gitmodules",
    "**/*.pem",
    "**/*.key"
  ],
  "manifest_excluded_path_fragments": [
    "__pycache__",
    ".egg-info/"
  ],
  "manifest_include_dirs": [
    "src",
    "schemas",
    "policies",
    "profiles"
  ],
  "manifest_include_files": [
    "pyproject.toml"
  ],
  "policy_version": "1.0.0",
  "project_specific_control_files": [],
  "repository": "Miskatonic-System/miskatonic-control-plane",
  "required_manifest_entries": [
    "pyproject.toml",
    "schemas/project-profile-v1.schema.json",
    "src/miskatonic_control/cli.py",
    "src/miskatonic_control/policy.py"
  ],
  "required_unchanged_patterns": [
    "^AGENTS\\.md$",
    "^bootstrap/"
  ],
  "schema_version": "prior-verification-policy-v1",
  "sealed_namespaces": [
    "bootstrap/**"
  ],
  "sealed_paths": [
    "AGENTS.md",
    "bootstrap/**"
  ]
}
