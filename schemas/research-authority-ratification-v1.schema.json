{
  "$id": "https://miskatonic.example/schemas/research-authority-ratification-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accept_bootstrap_independence_limits": {
      "const": true
    },
    "authority_accepted_head_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "authority_accepted_tree_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "authority_change_risk_class": {
      "const": "R2_SECURITY_OR_AUTHORITY_CHANGE"
    },
    "authority_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "authority_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "human_review_attestation": {
      "const": "I personally reviewed and authorize this exact bounded research risk decision."
    },
    "limitations": {
      "items": {
        "enum": [
          "DISTINCT_AGENT_REPORTED",
          "SHARED_PROVIDER",
          "SHARED_FILESYSTEM",
          "NO_OS_ISOLATED_REVIEW",
          "NO_SIGNED_REVIEWER_VERDICT",
          "HUMAN_RISK_ACCEPTANCE_NOT_SCIENTIFIC_REVIEW",
          "APPROVER_PRODUCER_TRANSPORT_OVERLAP_DISCLOSED",
          "GENERATED_ARTIFACTS_HASH_BOUND_NOT_FULLY_REVIEWED",
          "FINITE_COHORT_ONLY",
          "MODEL_REPRODUCED_NOT_PROVEN",
          "NO_GENERAL_SERIALIZABILITY_THEOREM",
          "HOSTED_CI_NOT_PASS",
          "LEGACY_TARGET_SCHEMA_INCOMPATIBLE",
          "RELEASE_AND_MERGE_SEPARATE"
        ]
      },
      "maxItems": 14,
      "minItems": 14,
      "type": "array",
      "uniqueItems": true
    },
    "purpose": {
      "const": "RATIFY_EXTERNAL_EVIDENCE_ADMISSION_V1"
    },
    "schema_version": {
      "const": "research-authority-ratification-v1"
    },
    "security_review_comment_id": {
      "minimum": 1,
      "type": "integer"
    },
    "security_review_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "authority_accepted_head_sha",
    "authority_root_sha256",
    "authority_policy_sha256",
    "candidate_digest",
    "human_review_attestation",
    "limitations",
    "authority_accepted_tree_sha",
    "authority_change_risk_class",
    "accept_bootstrap_independence_limits",
    "security_review_comment_id",
    "security_review_sha256"
  ],
  "type": "object"
}
