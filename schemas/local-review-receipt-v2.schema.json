{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed Local Review Receipt V2",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "issued_at",
    "repository",
    "pr_number",
    "head_branch",
    "base_sha",
    "head_sha",
    "candidate_digest",
    "review_packet_digest",
    "reviewer_implementation_digest",
    "model_identity",
    "prompt_and_schema",
    "review_coverage_manifest",
    "deterministic_verification_outcomes",
    "reviewer_service_identity",
    "verdict",
    "release_authorized",
    "confidence",
    "findings",
    "summary",
    "detached_signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "local-review-receipt-v2"
    },
    "receipt_id": {"type": "string"},
    "issued_at": {"type": "string"},
    "repository": {"type": "string"},
    "pr_number": {"type": "integer"},
    "head_branch": {"type": "string"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_packet_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "review_packet_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_implementation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_identity": {
      "type": "object",
      "required": [
        "backend",
        "model_name",
        "model_path",
        "model_weights_sha256",
        "model_size_bytes",
        "runtime_binary_path",
        "runtime_binary_sha256",
        "endpoint_url",
        "loopback_only_verified"
      ]
    },
    "prompt_and_schema": {
      "type": "object",
      "required": [
        "prompt_version",
        "prompt_template_sha256",
        "slice_schema_version",
        "slice_schema_sha256",
        "verdict_schema_version",
        "verdict_schema_sha256"
      ]
    },
    "review_coverage_manifest": {
      "type": "object",
      "required": [
        "total_changed_files",
        "classification_counts",
        "all_changed_files_accounted_for",
        "full_diff_files_total",
        "full_diff_files_reviewed",
        "full_diff_bytes_total",
        "full_diff_bytes_reviewed",
        "full_diff_aggregate_sha256",
        "slice_count",
        "slices"
      ]
    },
    "deterministic_verification_outcomes": {
      "type": "object",
      "required": [
        "prior_verification_verdict",
        "prior_verification_digest",
        "target_policy_path",
        "target_policy_sha256"
      ]
    },
    "reviewer_service_identity": {
      "type": "object",
      "required": [
        "reviewer_principal",
        "os_user",
        "os_uid",
        "os_gid",
        "working_directory",
        "candidate_checkout_path",
        "candidate_checkout_readonly_verified",
        "candidate_code_executed",
        "github_app_private_key_present_locally",
        "signing_key_id",
        "signing_public_key_fingerprint"
      ]
    },
    "producer_binding": {
      "type": "object"
    },
    "reviewer_policy_version": {"type": "string"},
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REQUEST_CHANGES", "REJECT"]
    },
    "release_authorized": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "uncertainty": {"type": "object"},
    "abstention": {"type": "object"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "title", "details", "path"]
      }
    },
    "summary": {"type": "string"},
    "detached_signature": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "public_key_fingerprint",
        "payload_sha256",
        "value_base64"
      ]
    }
  }
}
