{
  "$id": "https://miskatonic.example/schemas/research-admission-request-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_route": {
      "const": "EXTERNAL_EVIDENCE_ADMISSION_V1"
    },
    "authority_policy_reference": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "path": {
          "pattern": "^[a-zA-Z0-9_./-]+$",
          "type": "string"
        },
        "repository": {
          "const": "Miskatonic-System/miskatonic-review-authority"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "authority_root_reference": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "path": {
          "pattern": "^[a-zA-Z0-9_./-]+$",
          "type": "string"
        },
        "repository": {
          "const": "Miskatonic-System/miskatonic-review-authority"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "base_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "changed_path_count": {
      "const": 53
    },
    "ci_evidence_reference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "RECOMPUTED_AUTHORITY_EVIDENCE"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256"
      ],
      "type": "object"
    },
    "head_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "human_authorization_reference": {
      "additionalProperties": false,
      "properties": {
        "environment": {
          "const": "research-evidence-admission"
        },
        "kind": {
          "const": "GITHUB_PROTECTED_ENVIRONMENT_REVIEW"
        },
        "run_id": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "environment",
        "run_id"
      ],
      "type": "object"
    },
    "pr_number": {
      "const": 156
    },
    "prior_verification_reference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "RECOMPUTED_AUTHORITY_EVIDENCE"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256"
      ],
      "type": "object"
    },
    "repository": {
      "const": "Miskatonic-System/msk-ruliology"
    },
    "request_id": {
      "pattern": "^research-[0-9a-f]{64}$",
      "type": "string"
    },
    "review_limitations": {
      "items": {
        "enum": [
          "DISTINCT_AGENT_REPORTED",
          "SHARED_PROVIDER",
          "SHARED_FILESYSTEM",
          "NO_OS_ISOLATED_REVIEW",
          "NO_SIGNED_REVIEWER_VERDICT",
          "HUMAN_RISK_ACCEPTANCE_NOT_SCIENTIFIC_REVIEW",
          "APPROVER_PRODUCER_TRANSPORT_OVERLAP_DISCLOSED",
          "GENERATED_ARTIFACTS_HASH_BOUND_NOT_FULLY_REVIEWED",
          "FINITE_COHORT_ONLY",
          "MODEL_REPRODUCED_NOT_PROVEN",
          "NO_GENERAL_SERIALIZABILITY_THEOREM",
          "HOSTED_CI_NOT_PASS",
          "LEGACY_TARGET_SCHEMA_INCOMPATIBLE",
          "RELEASE_AND_MERGE_SEPARATE"
        ]
      },
      "maxItems": 14,
      "minItems": 14,
      "type": "array",
      "uniqueItems": true
    },
    "review_packet_manifest_reference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "RECOMPUTED_AUTHORITY_EVIDENCE"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256"
      ],
      "type": "object"
    },
    "review_report_reference": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "path": {
          "pattern": "^[a-zA-Z0-9_./-]+$",
          "type": "string"
        },
        "repository": {
          "const": "Miskatonic-System/miskatonic-review-authority"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "review_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "review_verdict": {
      "const": "ACCEPT_WITH_LIMITATIONS"
    },
    "reviewer_identity": {
      "const": "reported-agent:r2_independent_review:openai-codex"
    },
    "reviewer_independence_class": {
      "const": "DISTINCT_AGENT_SHARED_PROVIDER_AND_FILESYSTEM"
    },
    "risk_class": {
      "const": "R1_EXPERIMENTAL_RESEARCH"
    },
    "schema_version": {
      "const": "research-admission-request-v1"
    },
    "target_policy_reference": {
      "additionalProperties": false,
      "properties": {
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "path": {
          "pattern": "^[a-zA-Z0-9_./-]+$",
          "type": "string"
        },
        "repository": {
          "const": "Miskatonic-System/miskatonic-review-authority"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "tree_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "repository",
    "pr_number",
    "base_sha",
    "head_sha",
    "tree_sha",
    "candidate_digest",
    "target_policy_reference",
    "authority_policy_reference",
    "authority_root_reference",
    "risk_class",
    "admission_route",
    "review_report_reference",
    "review_report_sha256",
    "reviewer_identity",
    "reviewer_independence_class",
    "review_verdict",
    "review_limitations",
    "prior_verification_reference",
    "review_packet_manifest_reference",
    "changed_path_count",
    "ci_evidence_reference",
    "human_authorization_reference"
  ],
  "type": "object"
}
