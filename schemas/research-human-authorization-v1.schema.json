{
  "$id": "https://miskatonic.example/schemas/research-human-authorization-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accept_ci_compensating_controls": {
      "const": true
    },
    "accept_independence_limitations": {
      "const": true
    },
    "authority_head_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "authority_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "authority_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ci_assessment_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "human_review_attestation": {
      "const": "I personally reviewed and authorize this exact bounded research risk decision."
    },
    "limitations": {
      "items": {
        "enum": [
          "DISTINCT_AGENT_REPORTED",
          "SHARED_PROVIDER",
          "SHARED_FILESYSTEM",
          "NO_OS_ISOLATED_REVIEW",
          "NO_SIGNED_REVIEWER_VERDICT",
          "HUMAN_RISK_ACCEPTANCE_NOT_SCIENTIFIC_REVIEW",
          "APPROVER_PRODUCER_TRANSPORT_OVERLAP_DISCLOSED",
          "GENERATED_ARTIFACTS_HASH_BOUND_NOT_FULLY_REVIEWED",
          "FINITE_COHORT_ONLY",
          "MODEL_REPRODUCED_NOT_PROVEN",
          "NO_GENERAL_SERIALIZABILITY_THEOREM",
          "HOSTED_CI_NOT_PASS",
          "LEGACY_TARGET_SCHEMA_INCOMPATIBLE",
          "RELEASE_AND_MERGE_SEPARATE"
        ]
      },
      "maxItems": 14,
      "minItems": 14,
      "type": "array",
      "uniqueItems": true
    },
    "purpose": {
      "enum": [
        "RATIFY_EXTERNAL_EVIDENCE_ADMISSION_V1",
        "ADMIT_EXACT_CAUSALIS_RESEARCH"
      ]
    },
    "request_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "research-human-authorization-v1"
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "authority_head_sha",
    "authority_root_sha256",
    "authority_policy_sha256",
    "candidate_digest",
    "request_digest",
    "ci_assessment_digest",
    "expires_at",
    "human_review_attestation",
    "accept_independence_limitations",
    "accept_ci_compensating_controls",
    "limitations"
  ],
  "type": "object"
}
