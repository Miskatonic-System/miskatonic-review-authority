  "content": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"authority_principal\": {\"type\": \"string\"},\n    \"authority_workflow_run_id\": {\"type\": \"string\"},\n    \"base_sha\": {\"pattern\": \"^[0-9a-f]{40}$\", \"type\": \"string\"},\n    \"candidate_digest\": {\"pattern\": \"^[0-9a-f]{64}$\", \"type\": \"string\"},\n    \"confidence\": {\"maximum\": 1, \"minimum\": 0, \"type\": \"number\"},\n    \"findings\": {\"type\": \"array\"},\n    \"head_sha\": {\"pattern\": \"^[0-9a-f]{40}$\", \"type\": \"string\"},\n    \"issued_at\": {\"type\": \"string\"},\n    \"pr_number\": {\"minimum\": 1, \"type\": \"integer\"},\n    \"producer_binding\": {\"type\": \"object\"},\n    \"release_authorized\": {\"type\": \"boolean\"},\n    \"repository\": {\"type\": \"string\"},\n    \"review_execution\": {\"type\": \"object\"},\n    \"review_model_requested\": {\"type\": \"string\"},\n    \"review_provider\": {\"type\": \"string\"},\n    \"reviewer_policy_version\": {\"type\": \"string\"},\n    \"reviewer_principal\": {\"type\": \"string\"},\n    \"schema_version\": {\"const\": \"review-attestation-v1\"},\n    \"signature\": {\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"algorithm\": {\"const\": \"RSASSA-PKCS1-v1_5-SHA256\"},\n        \"key_id\": {\"type\": \"string\"},\n        \"value_base64\": {\"type\": \"string\"}\n      },\n      \"required\": [\"algorithm\", \"key_id\", \"value_base64\"],\n      \"type\": \"object\"\n    },\n    \"summary\": {\"type\": \"string\"},\n    \"verdict\": {\"enum\": [\"APPROVE\", \"REQUEST_CHANGES\", \"REJECT\"]}\n  },\n  \"required\": [\n    \"schema_version\",\n    \"authority_principal\",\n    \"authority_workflow_run_id\",\n    \"repository\",\n    \"pr_number\",\n    \"base_sha\",\n    \"head_sha\",\n    \"candidate_digest\",\n    \"producer_binding\",\n    \"reviewer_principal\",\n    \"review_provider\",\n    \"review_model_requested\",\n    \"review_execution\",\n    \"verdict\",\n    \"release_authorized\",\n    \"summary\",\n    \"findings\",\n    \"confidence\",\n    \"reviewer_policy_version\",\n    \"issued_at\",\n    \"signature\"\n  ],\n  \"title\": \"MiskatonicReviewAttestationV1\",\n  \"type\": \"object\"\n}\n",
